{
  "name": "gsi-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "GSI AI Studio monorepo — apps/kid (kids.gsi.ai) + apps/school (schools.gsi.ai) + shared packages/*.",
  "scripts": {
    "dev:kid": "pnpm --filter @gsi/app-kid dev",
    "dev:school": "pnpm --filter @gsi/app-school dev",
    "dev": "concurrently -n kid,school -c blue,green \"pnpm dev:kid\" \"pnpm dev:school\"",
    "dev:full": "concurrently -n kid,school,emu -c blue,green,magenta \"pnpm dev:kid\" \"pnpm dev:school\" \"firebase emulators:start\"",
    "build": "pnpm -r --filter @gsi/app-* build",
    "build:kid": "pnpm --filter @gsi/app-kid build",
    "build:school": "pnpm --filter @gsi/app-school build",
    "start:kid": "pnpm --filter @gsi/app-kid start",
    "start:school": "pnpm --filter @gsi/app-school start",
    "lint": "pnpm -r --filter @gsi/app-* lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ai-eval": "vitest run packages/ai/src/eval",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "seed:test": "tsx scripts/seed-test-data.ts",
    "seed:test:emulator": "FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 tsx scripts/seed-test-data.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/genai": "^1.43.0",
    "@hookform/resolvers": "^3.3.0",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-font-family": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@vercel/og": "^0.9.0",
    "ai": "^3.1.0",
    "canvas-confetti": "^1.9.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "firebase": "^10.12.0",
    "firebase-admin": "^12.1.0",
    "framer-motion": "^11.1.0",
    "groq-sdk": "^0.37.0",
    "howler": "^2.2.0",
    "jspdf": "^4.2.0",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.378.0",
    "marked": "^18.0.3",
    "nanoid": "^5.0.0",
    "next": "^14.2.0",
    "next-pwa": "^5.6.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.51.0",
    "replicate": "^0.30.0",
    "swr": "^2.2.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "firebase-tools": "^13.7.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "prettier": "^3.2.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
