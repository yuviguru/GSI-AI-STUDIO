rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Creations ───────────────────────────────────────────
    // Phase 1: Public read for published, server-side write only
    match /creations/{creationId} {
      allow read: if resource.data.isPublic == true || resource.data.status == 'published';
      allow write: if false; // Server-side only via Admin SDK
    }

    // ─── Sessions ────────────────────────────────────────────
    // Phase 1: Rate limiting — server-side only
    match /sessions/{sessionId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── Users (Phase 2) ─────────────────────────────────────
    // Parents and teachers — read own profile only, write server-side
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Server-side only
    }

    // ─── Kids (Phase 2 — top-level collection) ───────────────
    // Top-level kid profiles. Read by:
    // - The kid themselves (if they have a Google Auth account)
    // - Server-side for parent/teacher access (via Admin SDK)
    match /kids/{kidId} {
      allow read: if request.auth != null && request.auth.uid == kidId;
      allow write: if false; // Server-side only
    }

    // ─── Invites (Phase 2) ───────────────────────────────────
    // Parent-kid linking codes — server-side only
    match /invites/{inviteId} {
      allow read, write: if false; // Server-side only
    }

    // ─── Curriculum ──────────────────────────────────────────
    // Read-only reference data
    match /curriculum/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Beat the AI Rounds ──────────────────────────────────
    // Human vs AI challenge rounds — server-side only
    match /beatTheAiRounds/{roundId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── MindX Assessments ──────────────────────────────────
    // MindX skill assessments — server-side only
    match /skillArenaAssessments/{assessmentId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── Schools (Phase 3) ──────────────────────────────────
    // All reads/writes flow through authenticated server routes. Clients
    // must NEVER read schools or classes directly — class docs contain
    // inviteCode, which is the trust anchor for student enrolment. A
    // generic "authenticated user" read grant would let any signed-in
    // parent scrape every invite code across every school and enrol
    // their kid into arbitrary classes.
    match /schools/{schoolId} {
      allow read, write: if false; // Server-side only via Admin SDK

      match /classes/{classId} {
        allow read, write: if false; // Server-side only
      }
    }

    // ─── Class Invite Codes registry (Phase 3) ──────────────
    // Primary-key uniqueness registry: classInviteCodes/{code} ->
    // { schoolId, classId }. Locked to server-only; clients look up
    // classes through /api/classes/join which validates the kid's
    // ownership before enrolling.
    match /classInviteCodes/{code} {
      allow read, write: if false; // Server-side only
    }

    // ─── Assignments (Phase 3) ──────────────────────────────
    // Top-level collection. Access control is enforced server-side via
    // requireRole + ownership checks; clients never read this directly.
    match /assignments/{assignmentId} {
      allow read, write: if false; // Server-side only
    }

    // ─── Submissions (Phase 3) ──────────────────────────────
    // Creations submitted to assignments.
    match /submissions/{submissionId} {
      allow read, write: if false; // Server-side only
    }

    // ─── School Analytics (Phase 3) ─────────────────────────
    // Cached aggregate metrics per school. Refreshed daily by scheduled
    // Netlify function; never written by clients.
    match /schoolAnalytics/{schoolId} {
      allow read, write: if false; // Server-side only
    }

    // ─── Cerebro Competitions (Phase 2+) ─────────────────────
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Cerebro Exam Sessions (Phase 2+) ──────────────────
    match /examSessions/{examSessionId} {
      allow read, write: if false;
    }

    // ─── Cerebro Leaderboards (Phase 2+) ───────────────────
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── GrowthMap Reports (Phase 2+) ──────────────────────
    match /growthMapReports/{reportId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ─── Challenges (Phase 2+) ──────────────────────────────
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Kid CEO Business Simulation ────────────────────────
    // Business state — server-side only via Admin SDK
    match /ceoBusiness/{businessId} {
      allow read, write: if false;
    }

    // Events — server-side only
    match /ceoEvents/{eventId} {
      allow read, write: if false;
    }

    // CEO Profile — public read when isPublic == true (shareable DNA Card)
    match /ceoProfiles/{profileId} {
      allow read: if resource.data.isPublic == true;
      allow write: if false; // Server-side only
    }

    // ─── Bot Infrastructure ─────────────────────────────────
    // Per-chat bot session — server-side only
    match /botSessions/{chatId} {
      allow read, write: if false;
    }

    // Auth binding tokens (short-lived) — server-side only
    match /botLinkCodes/{token} {
      allow read, write: if false;
    }

    // Homework interactive sessions — server-side only
    match /homeworkSessions/{sessionId} {
      allow read, write: if false;
    }

    // Homework forward rate-limit windows — server-side only
    match /homeworkRateLimits/{key} {
      allow read, write: if false;
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
