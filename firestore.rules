rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Creations ───────────────────────────────────────────
    // Phase 1: Public read for published, server-side write only
    match /creations/{creationId} {
      allow read: if resource.data.isPublic == true || resource.data.status == 'published';
      allow write: if false; // Server-side only via Admin SDK
    }

    // ─── Sessions ────────────────────────────────────────────
    // Phase 1: Rate limiting — server-side only
    match /sessions/{sessionId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── Users (Phase 2+) ───────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Server-side only

      // Kid profiles (sub-collection)
      match /kids/{kidId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false; // Server-side only
      }
    }

    // ─── Curriculum ──────────────────────────────────────────
    // Read-only reference data
    match /curriculum/{topicId} {
      allow read: if true;
      allow write: if false;
    }

    // ─── Beat the AI Rounds ──────────────────────────────────
    // Human vs AI challenge rounds — server-side only
    match /beatTheAiRounds/{roundId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── MindX Assessments ──────────────────────────────────
    // MindX skill assessments — server-side only
    match /skillArenaAssessments/{assessmentId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── Cerebro Competitions (Phase 2+) ─────────────────────
    // Competition definitions — public read, admin write
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if false; // Server-side only via Admin SDK
    }

    // ─── Cerebro Exam Sessions (Phase 2+) ──────────────────
    // Individual exam attempts — server-side only (anti-cheat)
    match /examSessions/{examSessionId} {
      allow read, write: if false; // Server-side only via Admin SDK
    }

    // ─── Cerebro Leaderboards (Phase 2+) ───────────────────
    // Aggregated leaderboard data — public read
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Server-side only via Cloud Functions
    }

    // ─── GrowthMap Reports (Phase 2+) ──────────────────────
    // Parent insight reports — parent can only read their own kids' reports
    match /growthMapReports/{reportId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only via Cloud Functions
    }

    // ─── Challenges (Phase 2+) ──────────────────────────────
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false; // Server-side only
    }

    // ─── Schools (Phase 3) ──────────────────────────────────
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if false; // Server-side only
    }

    // Default: deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
