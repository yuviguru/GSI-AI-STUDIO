# AI Services (Server-side only — no NEXT_PUBLIC_ prefix)
ANTHROPIC_API_KEY="sk-ant-your-key-here"
REPLICATE_API_TOKEN="r8_your-token-here"
GEMINI_API_KEY="your-gemini-key-here"
GROQ_API_KEY="your-groq-key-here"

# Hugging Face Inference API (optional — free fallback for open-source Whisper STT)
# Without a token the HF Whisper fallback still works but rate-limits harder.
# HF_API_TOKEN="hf_your-free-token-here"

# Local ComfyUI (optional — for local dev with FLUX.1 Schnell)
# COMFYUI_URL="http://localhost:8000"

# Image sourcing — set IMAGE_MODE to pick the strategy
#   hybrid (recommended prod) → Pexels search first, AI-generate fallback, SVG last
#   search → Pexels → Unsplash → SVG (no AI cost, stock photos only)
#   generate → AI (ComfyUI → Replicate → Pollinations) (legacy default)
IMAGE_MODE="hybrid"
PEXELS_API_KEY="your-pexels-api-key"
# UNSPLASH_ACCESS_KEY="your-unsplash-access-key"  # optional fallback if Pexels hits 200/hr cap

# Pixazo — free hosted Flux Schnell for AI image generation (https://www.pixazo.ai/api/free).
# Takes priority over Replicate SDXL in the AI cascade whenever the key is set.
# Endpoint defaults to the public gateway; override PIXAZO_API_ENDPOINT only if
# Pixazo changes their URL in the future.
PIXAZO_API_KEY="your-pixazo-subscription-key"
# PIXAZO_API_ENDPOINT="https://gateway.pixazo.ai/flux-1-schnell/v1/getData"

# Firebase (Client-side — NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Firebase Admin (Server-side only)
# Option A: Individual fields (recommended for Netlify — smallest env var footprint)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Option B: Base64-encoded full service account JSON (alternative for local dev)
# FIREBASE_SERVICE_ACCOUNT="base64-encoded-service-account-json"

# Telegram Bots
# @GSIPersonalAssistantBot — studio deep-link commands (/story /music /quiz /creations /link)
TELEGRAM_BOT_TOKEN_STUDIO="123456789:AAA-your-studio-bot-token"
TELEGRAM_WEBHOOK_SECRET_STUDIO="your-random-webhook-secret-studio"
# @GSIKidCeoAssistantBot — Kid CEO game (full bot module)
TELEGRAM_BOT_TOKEN_CEO="123456789:AAA-your-ceo-bot-token"
TELEGRAM_WEBHOOK_SECRET_CEO="your-random-webhook-secret-ceo"
# Protects the /bot-setup Netlify Function that registers webhooks with Telegram
BOT_SETUP_SECRET="your-bot-setup-secret"

# Linear → GitHub Actions automation (Netlify Functions)
GITHUB_PAT="ghp_your-github-pat-here"
LINEAR_WEBHOOK_SECRET="your-linear-webhook-secret"

# Razorpay (Phase 2)
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# App URLs
# NEXT_PUBLIC_APP_URL is the canonical app URL used by share/view routes and viewer pages.
# NEXT_PUBLIC_URL is a legacy alias read by the bot modules (lib/bot/modules/ceo.ts) and bot-setup.
# Both should point to the same production URL. Unification is tracked as tech-debt.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_URL="http://localhost:3000"
